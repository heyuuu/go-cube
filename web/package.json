{
  "name": "cube-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "oxfmt --check . && oxlint . && tsgo -b --noEmit",
    "check:fix": "oxfmt . && oxlint --fix . && tsgo -b --noEmit",
    "gen:api": "../run.sh openapi -o openapi.json && openapi-typescript openapi.json -o src/api/schema.d.ts && oxfmt src/api/schema.d.ts",
    "verify:shadcn": "node scripts/verify-shadcn.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.75.0",
    "shadcn": "^4.18.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
